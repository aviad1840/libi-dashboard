# LIBI Dashboard — environment variables
#
# Copy this file to `.env` and fill in real values when integrating
# with a backend. The pilot build currently uses localStorage and
# requires no environment variables.
#
# Vite exposes only variables prefixed with VITE_ to the browser.

# --- Future: Supabase ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# --- Future: error monitoring ---
# VITE_SENTRY_DSN=

# --- Future: analytics ---
# VITE_POSTHOG_KEY=
