{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opportunity",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "deadline",
    "relevance",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^op-\\d{4}-\\d{3}$"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "enum": [
        "תחרות",
        "קול קורא",
        "RFI",
        "מכרז",
        "כנס",
        "הרצאה",
        "מלגה",
        "מינוי",
        "משרה"
      ]
    },
    "owner_org": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "days_left": {
      "type": "integer"
    },
    "relevance": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "why_relevant": {
      "type": "string"
    },
    "effort_estimate": {
      "enum": [
        "נמוך",
        "בינוני",
        "גבוה"
      ]
    },
    "advances": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "OQ/C/P שזה מקדם"
    },
    "source_url": {
      "type": "string"
    },
    "status": {
      "enum": [
        "חדש",
        "בבדיקה",
        "הוחלט להגיש",
        "נדחה",
        "הוגש"
      ]
    }
  }
}