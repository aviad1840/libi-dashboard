# aviad-desk interface layer - secrets
#
# העתק לקובץ .env (לא נכנס ל-git, ראה .gitignore) או הגדר כמשתני סביבה
# ברמת ה-Claude Code environment (claude.ai/code -> Environments -> משתני סביבה).
# הרוטינים בענן קוראים משתני סביבה, לא מקובץ - הם רצים בקלון טרי של הריפו בכל ירייה.
#
# https://code.claude.com/docs/en/claude-code-on-the-web מסביר איך מגדירים
# משתני סביבה ברמת ה-environment.

# --- Telegram ---
# צור בוט חדש מול @BotFather בטלגרם: /newbot, קבל טוקן.
TELEGRAM_BOT_TOKEN=

# מחרוזת סוד לבחירתך, לשימוש חד-פעמי בהרשמה (/start <קוד>).
# אחרי ההרשמה ה-chat_id נכתב ל-aviad-desk/config/telegram.json (לא סוד - רק מזהה),
# והקוד הזה כבר לא נדרש שוב.
TELEGRAM_SETUP_CODE=

# --- Email (יוצא בלבד - SMTP) ---
# לג'ימייל: הפעל אימות דו-שלבי וצור App Password ב-myaccount.google.com/apppasswords
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_APP_PASSWORD=
EMAIL_TO=aviad1840@gmail.com
